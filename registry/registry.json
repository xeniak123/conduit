    {
      "id": "mcp-supabase",
      "kind": "mcp",
      "name": "Supabase",
      "summary": "Query tables, run migrations and read logs in your Supabase projects.",
      "author": "Supabase",
      "license": "Apache-2.0",
      "homepage": "https://github.com/supabase-community/supabase-mcp",
      "tags": [
        "database",
        "backend"
      ],
      "icon": "database",
      "tint": "mint",
      "mcp": {
        "command": "npx",
        "args": [
          "-y",
          "@supabase/mcp-server-supabase@latest",
          "--read-only"
        ],
        "env": [
          {
            "name": "SUPABASE_ACCESS_TOKEN",
            "secret": "mcp-supabase",
            "label": "Supabase access token",
            "help": "Create one under Account, Access tokens."
          }
        ],
        "note": "Starts read-only. Remove --read-only from the command if you want it to change data."
      }
    },
